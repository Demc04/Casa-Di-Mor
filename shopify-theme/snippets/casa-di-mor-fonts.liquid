{% comment %}
  Casa Di Mor — Snippet de fuentes y preconexión
  Incluir en <head> desde theme.liquid
{% endcomment %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Pinyon+Script&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ 'casa-di-mor-brand.css' | asset_url }}">
<script>
(function(){
  var TABLE = '<table class="cdm-sg"><thead><tr><th>Talla</th><th>Busto</th><th>Cintura</th><th>Cadera</th></tr></thead><tbody><tr><td>XS</td><td>92</td><td>68</td><td>96</td></tr><tr><td>S</td><td>96</td><td>72</td><td>100</td></tr><tr><td>M</td><td>100</td><td>76</td><td>104</td></tr><tr><td>L</td><td>104</td><td>80</td><td>108</td></tr><tr><td>XL</td><td>108</td><td>84</td><td>112</td></tr></tbody></table><p class="cdm-sg-note">Medidas en centímetros</p>';
  function inject(){
    document.querySelectorAll('[class*="text_qLGEN9"]').forEach(function(el){
      el.innerHTML = TABLE;
    });
  }
  if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',inject);}
  else{inject();}
  document.addEventListener('shopify:section:load',inject);
})();
</script>