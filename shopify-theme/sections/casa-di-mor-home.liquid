{{ 'casa-di-mor-home.css' | asset_url | stylesheet_tag }}

<div class="cdm-home">

  {%- comment -%} ---- Hero ---- {%- endcomment -%}
  <div class="cdm-home-hero">
    <div class="cdm-home-figure cdm-home-figure--hero">
      {%- if section.settings.hero_image -%}
        <img class="cdm-home-figure__img" src="{{ section.settings.hero_image | image_url: width: 1800 }}" alt="{{ section.settings.hero_title | escape }}" loading="eager">
      {%- else -%}
        <img class="cdm-home-figure__img" src="{{ 'cdm-editorial-sea-gown.jpg' | asset_url }}" alt="{{ section.settings.hero_title | escape }}" loading="eager">
      {%- endif -%}
      <div class="cdm-home-figure__scrim" style="background: linear-gradient(to top, rgba(34,28,23,.62), rgba(34,28,23,.12) 48%, transparent 72%);"></div>
      <div class="cdm-home-figure__content">
        {%- if section.settings.hero_eyebrow != blank -%}
          <span class="cdm-home-figure__eyebrow">{{ section.settings.hero_eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.hero_title != blank -%}
          <p class="cdm-home-figure__title">{{ section.settings.hero_title }}</p>
        {%- endif -%}
        {%- if section.settings.hero_subtitle != blank -%}
          <p class="cdm-home-figure__sub">{{ section.settings.hero_subtitle }}</p>
        {%- endif -%}
        {%- if section.settings.hero_button_label != blank -%}
          <div style="margin-top: 10px;">
            <a href="{{ section.settings.hero_button_link | default: '#' }}" class="cdm-home-btn">{{ section.settings.hero_button_label }}</a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- comment -%} ---- Statement / purpose ---- {%- endcomment -%}
  <section class="cdm-home-section cdm-home-wrap">
    <div class="cdm-home-statement">
      {%- if section.settings.statement_image -%}
        <img class="cdm-home-seal" src="{{ section.settings.statement_image | image_url: width: 264 }}" alt="Casa Di Mor">
      {%- else -%}
        <img class="cdm-home-seal" src="{{ 'cdm-key-espresso.png' | asset_url }}" alt="Casa Di Mor">
      {%- endif -%}
      {%- if section.settings.statement_eyebrow != blank -%}
        <span class="cdm-home-eyebrow">{{ section.settings.statement_eyebrow | upcase | split: '' | join: ' ' }}</span>
      {%- endif -%}
      {%- if section.settings.statement_text != blank -%}
        <p class="cdm-home-quote">{{ section.settings.statement_text }}</p>
      {%- endif -%}
    </div>
  </section>

  {%- comment -%} ---- Capsule / product grid ---- {%- endcomment -%}
  <section class="cdm-home-section cdm-home-wrap" style="padding-top: 0;">
    <div class="cdm-home-sec-head">
      <div>
        {%- if section.settings.capsule_script != blank -%}
          <div class="cdm-home-script">{{ section.settings.capsule_script }}</div>
        {%- endif -%}
        {%- if section.settings.capsule_title != blank -%}
          <h2>{{ section.settings.capsule_title }}</h2>
        {%- endif -%}
      </div>
      {%- if section.settings.collection_link != blank -%}
        <a class="cdm-home-link" href="{{ section.settings.collection_link }}">Ver todo</a>
      {%- endif -%}
    </div>
    <div class="cdm-home-grid">

      <div class="cdm-home-card">
        <div class="cdm-home-card__media">
          <img class="cdm-home-card__img" src="{{ 'cdm-look-white-dress.jpg' | asset_url }}" alt="Vestido Luz" loading="lazy">
        </div>
        <div class="cdm-home-card__body">
          <div class="cdm-home-card__name">Vestido Luz</div>
          <div class="cdm-home-card__row">
            <span class="cdm-home-card__price">€ 280</span>
            <span class="cdm-home-card__swatches">
              <span class="cdm-home-card__dot" style="background: #f2ede6;"></span>
              <span class="cdm-home-card__dot" style="background: #b0c2e1;"></span>
              <span class="cdm-home-card__dot" style="background: #42270f;"></span>
            </span>
          </div>
        </div>
      </div>

      <div class="cdm-home-card">
        <div class="cdm-home-card__media">
          <img class="cdm-home-card__img" src="{{ 'cdm-look-02.jpg' | asset_url }}" alt="Maxi Mare" loading="lazy">
          <span class="cdm-home-card__tag"><span class="cdm-home-tag">Nuevo</span></span>
        </div>
        <div class="cdm-home-card__body">
          <div class="cdm-home-card__name">Maxi Mare</div>
          <div class="cdm-home-card__row">
            <span class="cdm-home-card__price">€ 340</span>
            <span class="cdm-home-card__swatches">
              <span class="cdm-home-card__dot" style="background: #b0c2e1;"></span>
              <span class="cdm-home-card__dot" style="background: #f2ede6;"></span>
            </span>
          </div>
        </div>
      </div>

      <div class="cdm-home-card">
        <div class="cdm-home-card__media">
          <img class="cdm-home-card__img" src="{{ 'cdm-look-03.jpg' | asset_url }}" alt="Piping Atena" loading="lazy">
        </div>
        <div class="cdm-home-card__body">
          <div class="cdm-home-card__name">Piping Atena</div>
          <div class="cdm-home-card__row">
            <span class="cdm-home-card__price">€ 310</span>
            <span class="cdm-home-card__swatches">
              <span class="cdm-home-card__dot" style="background: #efe8df;"></span>
              <span class="cdm-home-card__dot" style="background: #42270f;"></span>
            </span>
          </div>
        </div>
      </div>

      <div class="cdm-home-card">
        <div class="cdm-home-card__media">
          <img class="cdm-home-card__img" src="{{ 'cdm-look-04.jpg' | asset_url }}" alt="Top Ola" loading="lazy">
        </div>
        <div class="cdm-home-card__body">
          <div class="cdm-home-card__name">Top Ola</div>
          <div class="cdm-home-card__row">
            <span class="cdm-home-card__price">€ 160</span>
            <span class="cdm-home-card__swatches">
              <span class="cdm-home-card__dot" style="background: #f2ede6;"></span>
            </span>
          </div>
        </div>
      </div>

    </div>
  </section>

  {%- comment -%} ---- Editorial split ---- {%- endcomment -%}
  <section class="cdm-home-wrap" style="padding-bottom: 96px;">
    <div class="cdm-home-split">
      <div class="cdm-home-figure cdm-home-figure--portrait">
        {%- if section.settings.split_image_1 -%}
          <img class="cdm-home-figure__img" src="{{ section.settings.split_image_1 | image_url: width: 1200 }}" alt="{{ section.settings.split_title_1 | escape }}" loading="lazy">
        {%- else -%}
          <img class="cdm-home-figure__img" src="{{ 'cdm-editorial-beach-group.jpg' | asset_url }}" alt="{{ section.settings.split_title_1 | escape }}" loading="lazy">
        {%- endif -%}
        <div class="cdm-home-figure__scrim" style="background: linear-gradient(to top, rgba(34,28,23,.55), rgba(34,28,23,.2));"></div>
        <div class="cdm-home-figure__content">
          {%- if section.settings.split_eyebrow_1 != blank -%}
            <span class="cdm-home-figure__eyebrow">{{ section.settings.split_eyebrow_1 }}</span>
          {%- endif -%}
          {%- if section.settings.split_title_1 != blank -%}
            <p class="cdm-home-figure__title">{{ section.settings.split_title_1 }}</p>
          {%- endif -%}
        </div>
      </div>
      <div class="cdm-home-figure cdm-home-figure--portrait">
        {%- if section.settings.split_image_2 -%}
          <img class="cdm-home-figure__img" src="{{ section.settings.split_image_2 | image_url: width: 1200 }}" alt="{{ section.settings.split_title_2 | escape }}" loading="lazy">
        {%- else -%}
          <img class="cdm-home-figure__img" src="{{ 'cdm-lifestyle-garden.jpg' | asset_url }}" alt="{{ section.settings.split_title_2 | escape }}" loading="lazy">
        {%- endif -%}
        <div class="cdm-home-figure__scrim" style="background: linear-gradient(to top, rgba(34,28,23,.55), rgba(34,28,23,.2));"></div>
        <div class="cdm-home-figure__content">
          {%- if section.settings.split_eyebrow_2 != blank -%}
            <span class="cdm-home-figure__eyebrow">{{ section.settings.split_eyebrow_2 }}</span>
          {%- endif -%}
          {%- if section.settings.split_title_2 != blank -%}
            <p class="cdm-home-figure__title">{{ section.settings.split_title_2 }}</p>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>

</div>

{% schema %}
{
  "name": "CDM Home",
  "settings": [
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Imagen del hero"
    },
    {
      "type": "text",
      "id": "hero_eyebrow",
      "label": "Eyebrow",
      "default": "Colección 2026"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Título",
      "default": "Verano eterno"
    },
    {
      "type": "textarea",
      "id": "hero_subtitle",
      "label": "Subtítulo",
      "default": "Lo suave, lo esencial y lo eterno en lo cotidiano."
    },
    {
      "type": "text",
      "id": "hero_button_label",
      "label": "Texto del botón",
      "default": "Descubrir la colección"
    },
    {
      "type": "url",
      "id": "hero_button_link",
      "label": "Enlace del botón"
    },
    {
      "type": "header",
      "content": "Propósito"
    },
    {
      "type": "image_picker",
      "id": "statement_image",
      "label": "Sello / imagen de marca"
    },
    {
      "type": "text",
      "id": "statement_eyebrow",
      "label": "Eyebrow",
      "default": "Propósito"
    },
    {
      "type": "textarea",
      "id": "statement_text",
      "label": "Texto",
      "default": "Que cada prenda sea una inversión, y no un gasto — liberando la frescura y el estilo atemporal de quien la porta."
    },
    {
      "type": "header",
      "content": "Cápsula Verano Eterno"
    },
    {
      "type": "text",
      "id": "capsule_script",
      "label": "Texto script",
      "default": "la cápsula"
    },
    {
      "type": "text",
      "id": "capsule_title",
      "label": "Título",
      "default": "Verano Eterno"
    },
    {
      "type": "url",
      "id": "collection_link",
      "label": "Enlace 'Ver todo'"
    },
    {
      "type": "header",
      "content": "Editorial"
    },
    {
      "type": "image_picker",
      "id": "split_image_1",
      "label": "Imagen 1"
    },
    {
      "type": "text",
      "id": "split_eyebrow_1",
      "label": "Eyebrow 1",
      "default": "Editorial"
    },
    {
      "type": "text",
      "id": "split_title_1",
      "label": "Título 1",
      "default": "La luz que ya existe en ti"
    },
    {
      "type": "image_picker",
      "id": "split_image_2",
      "label": "Imagen 2"
    },
    {
      "type": "text",
      "id": "split_eyebrow_2",
      "label": "Eyebrow 2",
      "default": "Atelier"
    },
    {
      "type": "text",
      "id": "split_title_2",
      "label": "Título 2",
      "default": "Maestría del detalle"
    }
  ],
  "presets": [
    {
      "name": "CDM Home"
    }
  ]
}
{% endschema %}
