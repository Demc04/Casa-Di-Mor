{{ 'casa-di-mor-ds.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  1:1 port of src/pages/HomePage.jsx using the components and
  tokens from src/styles + src/components/commerce + src/components/core.
  Structure, classes and copy mirror the design system exactly.
{%- endcomment -%}

<div style="margin-top: calc(var(--transparent-header-offset-boolean, 0) * -1 * var(--header-height, 0px)); position: relative; z-index: 0;">

  {%- comment -%} <div className="bq-hero"> EditorialFigure(hero) {%- endcomment -%}
  <div class="bq-hero">
    <div class="cdm-figure cdm-figure--hero cdm-figure--bottom cdm-figure--zoom">
      <img class="cdm-figure__img" src="{{ 'cdm-editorial-sea-gown.jpg' | asset_url }}" alt="Verano eterno">
      <div class="cdm-figure__scrim" style="background: linear-gradient(to top, rgba(34,28,23,.62), rgba(34,28,23,.12) 48%, transparent 72%);"></div>
      <div class="cdm-figure__content">
        <span class="cdm-figure__eyebrow">Colección 2026</span>
        <div class="cdm-figure__title">Verano eterno</div>
        <p class="cdm-figure__sub">Lo suave, lo esencial y lo eterno en lo cotidiano.</p>
        <div style="margin-top: 10px;">
          <a href="{{ section.settings.collection.url | default: section.settings.collection_url | default: '/collections/all' }}" class="cdm-btn cdm-btn--accent cdm-btn--md">Descubrir la colección</a>
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} <section className="bq-wrap"> Brand statement {%- endcomment -%}
  <section class="bq-wrap" style="padding-bottom: var(--space-9);">
    <a href="{{ section.settings.brand_story_url | default: '/pages/nuestra-historia' }}" class="bq-statement bq-statement--split bq-statement--link">
      <img class="bq-seal" src="{{ 'cdm-key-espresso.png' | asset_url }}" alt="Casa Di Mor">
      <span class="cdm-eyebrow">Una casa hecha de historias</span>
      <p class="q">Donde la elegancia se habita, la autenticidad se celebra y cada pieza acompaña la historia de quien la lleva.</p>
    </a>
  </section>

  {%- comment -%} <section className="bq-section bq-wrap" style={{paddingTop:0}}> Capsule grid {%- endcomment -%}
  <section class="bq-section" style="padding-top: 0;">
    <div class="bq-wrap">
      <div class="bq-sec-head">
        <div>
          <h2>Verano Eterno</h2>
        </div>
        <a class="bq-link" href="{{ section.settings.collection.url | default: section.settings.collection_url | default: '/collections/all' }}">Ver todo</a>
      </div>
    </div>

    {%- assign cat_blocks = section.blocks | where: 'type', 'category_card' -%}
    <div class="bq-cats" style="grid-template-columns: repeat(2, 1fr);">

      {%- for block in cat_blocks -%}
        {%- assign cat_url = section.settings.collection.url | default: section.settings.collection_url | default: '/collections/all' -%}
        {%- if block.settings.tag != blank -%}
          {%- assign tag_handle = block.settings.tag | handle -%}
          {%- assign cat_url = cat_url | append: '/' | append: tag_handle -%}
        {%- endif -%}
        {%- comment -%} CategoryCard: {{ block.settings.title }} {%- endcomment -%}
        <a href="{{ cat_url }}" class="bq-cat" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img class="bq-cat__img" src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.image.alt | default: block.settings.title }}">
          {%- endif -%}
          <div class="bq-cat__scrim"></div>
          <div class="bq-cat__title">{{ block.settings.title }}</div>
        </a>
      {%- endfor -%}

    </div>
  </section>

  {%- comment -%} Marquee de fotos elegidas manualmente {%- endcomment -%}
  {%- assign marquee_blocks = section.blocks | where: 'type', 'marquee_image' -%}
  {%- if marquee_blocks.size > 0 -%}
    <section class="bq-section" style="padding-top: 0;">
      <div class="bq-grid bq-grid--marquee">
        <div class="bq-grid__track">
          {%- for n in (1..2) -%}
            <div class="cdm-pcard bq-marquee-promo" style="cursor: default;">
              <div class="bq-marquee-promo__inner">
                <span class="cdm-eyebrow">Introducing</span>
                <h3 class="bq-marquee-promo__title">Verano Eterno</h3>
                <p class="bq-marquee-promo__body">Inspirada en la magia de los destinos costeros y los recuerdos que perduran, celebra la elegancia natural a través de siluetas ligeras y detalles que perduran.</p>
                <a href="{{ section.settings.collection.url | default: section.settings.collection_url | default: '/collections/all' }}" class="cdm-btn cdm-btn--outline cdm-btn--md">Descubrir ahora</a>
              </div>
            </div>
            {%- for block in marquee_blocks -%}
              {%- if block.settings.image != blank -%}
                <div class="cdm-pcard" style="cursor: default;" {{ block.shopify_attributes }}>
                  <div class="cdm-pcard__media">
                    <img class="cdm-pcard__img" src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.image.alt | default: '' }}">
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}


</div>

{% schema %}
{
  "name": "CDM Design System",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección Verano Eterno"
    },
    {
      "type": "url",
      "id": "collection_url",
      "label": "Enlace de colección (alternativo)"
    },
    {
      "type": "url",
      "id": "brand_story_url",
      "label": "Enlace a la página \"Nuestra historia\"",
      "info": "Por defecto apunta a /pages/nuestra-historia"
    }
  ],
  "blocks": [
    {
      "type": "category_card",
      "name": "Categoría",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Nombre",
          "default": "Categoría"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag de filtro",
          "info": "Debe coincidir exactamente con el tag/etiqueta que tienen los productos de esta categoría en Shopify (ej: Bottoms, Tops, Vestidos)."
        }
      ]
    },
    {
      "type": "marquee_image",
      "name": "Foto del carrusel",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "CDM Design System",
      "blocks": [
        { "type": "category_card", "settings": { "title": "Tops", "tag": "Tops" } },
        { "type": "category_card", "settings": { "title": "Bottoms", "tag": "Bottoms" } },
        { "type": "category_card", "settings": { "title": "Dresses", "tag": "Vestidos" } }
      ]
    }
  ]
}
{% endschema %}
